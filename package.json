{
  "name": "tilemap-generator",
  "productName": "Tilemap Generator",
  "version": "0.2.0-beta.3",
  "description": "Desktopowa fabryka assetów izometrycznych i top-down z integracjami eksportu",
  "main": ".vite/build/main.js",
  "author": "Tilemap Generator",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build:mcp": "vite build --config vite.mcp.config.ts",
    "native:electron": "electron-rebuild --force --only better-sqlite3",
    "native:node": "npm rebuild better-sqlite3",
    "prestart": "npm run native:electron",
    "start": "electron-forge start",
    "prepackage": "npm run build:mcp",
    "package": "electron-forge package",
    "premake": "npm run build:mcp",
    "make": "electron-forge make",
    "preexport:unity": "npm run native:node",
    "export:unity": "npx --yes vite-node src/export-unity-cli.ts",
    "postexport:unity": "npm run native:electron",
    "rebuild:terrain-blends": "npx --yes vite-node src/rebuild-terrain-blends-cli.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run native:node",
    "test": "vitest run",
    "posttest": "npm run native:electron",
    "pretest:watch": "npm run native:node",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.45.2",
    "extract-zip": "^2.0.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.2",
    "@electron-forge/plugin-fuses": "^7.10.2",
    "@electron-forge/plugin-vite": "^7.10.2",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^3.7.2",
    "@modelcontextprotocol/server": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^39.2.1",
    "jsdom": "^27.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
